{
  "openapi": "3.1.0",
  "info": {
    "title": "Monad Vanguard Sentinel local prototype API",
    "version": "0.1.0",
    "description": "Draft integration contract for a local, manually reviewed suspicious-contract workflow. Team approval is pending."
  },
  "servers": [{ "url": "http://127.0.0.1:8787" }],
  "paths": {
    "/health": {
      "get": {
        "summary": "Local health check",
        "responses": { "200": { "description": "Server is running" } }
      }
    },
    "/v1/reports": {
      "post": {
        "summary": "Submit a suspicious-contract report",
        "requestBody": {
          "required": true,
          "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ReportInput" } } }
        },
        "responses": {
          "201": { "description": "Submitted; not public", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/SubmissionReceipt" } } } },
          "400": { "$ref": "#/components/responses/Error" }
        }
      },
      "get": {
        "summary": "List full reports for review",
        "security": [{ "ReviewerBearer": [] }],
        "responses": {
          "200": { "description": "All reports", "content": { "application/json": { "schema": { "type": "object", "required": ["reports"], "properties": { "reports": { "type": "array", "items": { "$ref": "#/components/schemas/Report" } } } } } } },
          "401": { "$ref": "#/components/responses/Error" }
        }
      }
    },
    "/v1/reports/{id}": {
      "get": {
        "summary": "Get a full report for review",
        "security": [{ "ReviewerBearer": [] }],
        "parameters": [{ "$ref": "#/components/parameters/ReportId" }],
        "responses": {
          "200": { "description": "Full report", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Report" } } } },
          "401": { "$ref": "#/components/responses/Error" },
          "404": { "$ref": "#/components/responses/Error" }
        }
      }
    },
    "/v1/reports/{id}/review": {
      "post": {
        "summary": "Move a submitted report into review",
        "security": [{ "ReviewerBearer": [] }],
        "parameters": [{ "$ref": "#/components/parameters/ReportId" }],
        "responses": {
          "200": { "description": "Report in review", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Report" } } } },
          "409": { "$ref": "#/components/responses/Error" }
        }
      }
    },
    "/v1/reports/{id}/evidence": {
      "post": {
        "summary": "Add evidence during investigation",
        "security": [{ "ReviewerBearer": [] }],
        "parameters": [{ "$ref": "#/components/parameters/ReportId" }],
        "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/EvidenceInput" } } } },
        "responses": {
          "201": { "description": "Evidence added", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Evidence" } } } },
          "409": { "$ref": "#/components/responses/Error" }
        }
      }
    },
    "/v1/reports/{id}/check-evidence": {
      "post": {
        "summary": "Observe transaction evidence through configured read-only RPC",
        "description": "Requires RPC_URL. Chain observation never changes the human review verdict.",
        "security": [{ "ReviewerBearer": [] }],
        "parameters": [{ "$ref": "#/components/parameters/ReportId" }],
        "responses": {
          "200": { "description": "Recorded RPC observation", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/OnchainObservation" } } } },
          "502": { "$ref": "#/components/responses/Error" },
          "503": { "$ref": "#/components/responses/Error" }
        }
      }
    },
    "/v1/reports/{id}/decision": {
      "post": {
        "summary": "Manually verify or reject a report",
        "security": [{ "ReviewerBearer": [] }],
        "parameters": [{ "$ref": "#/components/parameters/ReportId" }],
        "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/DecisionInput" } } } },
        "responses": {
          "200": { "description": "Updated report", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Report" } } } },
          "409": { "$ref": "#/components/responses/Error" }
        }
      }
    },
    "/v1/reports/{id}/correction": {
      "post": {
        "summary": "Correct a published alert",
        "security": [{ "ReviewerBearer": [] }],
        "parameters": [{ "$ref": "#/components/parameters/ReportId" }],
        "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/CorrectionInput" } } } },
        "responses": {
          "200": { "description": "New alert version", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Alert" } } } },
          "409": { "$ref": "#/components/responses/Error" }
        }
      }
    },
    "/v1/reports/{id}/retraction": {
      "post": {
        "summary": "Retract a published alert",
        "security": [{ "ReviewerBearer": [] }],
        "parameters": [{ "$ref": "#/components/parameters/ReportId" }],
        "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/RetractionInput" } } } },
        "responses": {
          "200": { "description": "Retracted alert", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Alert" } } } },
          "409": { "$ref": "#/components/responses/Error" }
        }
      }
    },
    "/v1/alerts": {
      "get": {
        "summary": "List current verified public alerts",
        "responses": {
          "200": { "description": "Active public alerts", "content": { "application/json": { "schema": { "type": "object", "required": ["alerts"], "properties": { "alerts": { "type": "array", "items": { "$ref": "#/components/schemas/Alert" } } } } } } }
        }
      }
    },
    "/v1/alerts/history": {
      "get": {
        "summary": "List every previously published alert including retractions",
        "responses": {
          "200": { "description": "Published history", "content": { "application/json": { "schema": { "type": "object", "required": ["alerts"], "properties": { "alerts": { "type": "array", "items": { "$ref": "#/components/schemas/Alert" } } } } } } }
        }
      }
    },
    "/v1/dashboard": {
      "get": {
        "summary": "Counts of public incident classifications; not a safety score",
        "responses": {
          "200": { "description": "Public summary", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/DashboardSummary" } } } }
        }
      }
    },
    "/v1/notifications/outbox": {
      "get": {
        "summary": "List local notification drafts; no external delivery occurs",
        "security": [{ "ReviewerBearer": [] }],
        "responses": {
          "200": { "description": "Notification drafts", "content": { "application/json": { "schema": { "type": "object", "required": ["events"], "properties": { "events": { "type": "array", "items": { "$ref": "#/components/schemas/NotificationEvent" } } } } } } }
        }
      }
    },
    "/v1/contributors": {
      "get": {
        "summary": "Count reports by self-declared reporter ID; not a reputation score",
        "security": [{ "ReviewerBearer": [] }],
        "responses": {
          "200": { "description": "Contributor counts", "content": { "application/json": { "schema": { "type": "object", "required": ["contributors"], "properties": { "contributors": { "type": "array", "items": { "$ref": "#/components/schemas/ContributorSummary" } } } } } } }
        }
      }
    },
    "/v1/watchlist": {
      "get": {
        "summary": "List reviewer-managed watch targets",
        "security": [{ "ReviewerBearer": [] }],
        "responses": {
          "200": { "description": "All watch targets", "content": { "application/json": { "schema": { "type": "object", "required": ["targets"], "properties": { "targets": { "type": "array", "items": { "$ref": "#/components/schemas/WatchTarget" } } } } } } }
        }
      },
      "post": {
        "summary": "Add an address to the watchlist",
        "security": [{ "ReviewerBearer": [] }],
        "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/WatchTargetInput" } } } },
        "responses": {
          "201": { "description": "Watch target created", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/WatchTarget" } } } },
          "409": { "$ref": "#/components/responses/Error" }
        }
      }
    },
    "/v1/watchlist/{id}/check": {
      "post": {
        "summary": "Continue a manual event-log scan from the saved block cursor",
        "description": "The first check scans up to the latest 100 blocks. Later checks continue after the saved cursor, scanning at most 500 blocks per call in smaller RPC requests. A response with hasMore=true means another check is needed. No threat classification or automatic polling occurs. Recent logs are deduplicated by block hash and log index; chain reorganization reconciliation is not implemented.",
        "security": [{ "ReviewerBearer": [] }],
        "parameters": [{ "$ref": "#/components/parameters/WatchTargetId" }],
        "responses": {
          "200": { "description": "Recorded scan or up-to-date result", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/WatchObservation" } } } },
          "409": { "$ref": "#/components/responses/Error" },
          "502": { "$ref": "#/components/responses/Error" },
          "503": { "$ref": "#/components/responses/Error" }
        }
      }
    },
    "/v1/watchlist/{id}/archive": {
      "post": {
        "summary": "Archive a watch target while preserving its observations",
        "security": [{ "ReviewerBearer": [] }],
        "parameters": [{ "$ref": "#/components/parameters/WatchTargetId" }],
        "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/RetractionInput" } } } },
        "responses": {
          "200": { "description": "Archived watch target", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/WatchTarget" } } } },
          "409": { "$ref": "#/components/responses/Error" }
        }
      }
    },
    "/v1/alerts/{id}": {
      "get": {
        "summary": "Get a previously published alert, including later retraction",
        "parameters": [{ "$ref": "#/components/parameters/ReportId" }],
        "responses": {
          "200": { "description": "Published alert", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Alert" } } } },
          "404": { "$ref": "#/components/responses/Error" }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "ReviewerBearer": { "type": "http", "scheme": "bearer", "description": "Local demo token set with REVIEWER_TOKEN; reviewer ID is server-configured." }
    },
    "parameters": {
      "ReportId": { "name": "id", "in": "path", "required": true, "schema": { "type": "string", "format": "uuid" } },
      "WatchTargetId": { "name": "id", "in": "path", "required": true, "schema": { "type": "string", "format": "uuid" } }
    },
    "responses": {
      "Error": { "description": "Request failed", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } } }
    },
    "schemas": {
      "Error": {
        "type": "object", "required": ["error", "message"],
        "properties": { "error": { "type": "string" }, "message": { "type": "string" } }
      },
      "TransactionEvidenceInput": {
        "type": "object", "required": ["kind", "txHash", "note"],
        "properties": {
          "kind": { "const": "transaction" },
          "txHash": { "type": "string", "pattern": "^0x[0-9a-fA-F]{64}$" },
          "note": { "type": "string", "minLength": 10, "maxLength": 500 }
        }
      },
      "PublicSourceEvidenceInput": {
        "type": "object", "required": ["kind", "url", "note"],
        "properties": {
          "kind": { "const": "public_source" },
          "url": { "type": "string", "format": "uri", "description": "HTTPS without credentials, query or fragment" },
          "note": { "type": "string", "minLength": 10, "maxLength": 500 }
        }
      },
      "EvidenceInput": {
        "oneOf": [
          { "$ref": "#/components/schemas/TransactionEvidenceInput" },
          { "$ref": "#/components/schemas/PublicSourceEvidenceInput" }
        ]
      },
      "PublicEvidence": {
        "allOf": [
          { "$ref": "#/components/schemas/EvidenceInput" },
          { "type": "object", "required": ["id", "addedAt"], "properties": { "id": { "type": "string", "format": "uuid" }, "addedAt": { "type": "string", "format": "date-time" } } }
        ]
      },
      "Evidence": {
        "allOf": [
          { "$ref": "#/components/schemas/PublicEvidence" },
          { "type": "object", "properties": { "addedBy": { "type": "string" } } }
        ]
      },
      "ReportInput": {
        "type": "object", "required": ["reporterId", "chainId", "contractAddress", "title", "description", "evidence"],
        "properties": {
          "reporterId": { "type": "string", "minLength": 2, "maxLength": 80 },
          "chainId": { "type": "integer", "minimum": 1 },
          "contractAddress": { "type": "string", "pattern": "^0x[0-9a-fA-F]{40}$" },
          "title": { "type": "string", "minLength": 10, "maxLength": 160 },
          "description": { "type": "string", "minLength": 20, "maxLength": 2000 },
          "evidence": { "type": "array", "minItems": 1, "maxItems": 10, "items": { "$ref": "#/components/schemas/EvidenceInput" } }
        }
      },
      "SubmissionReceipt": {
        "type": "object", "required": ["id", "status", "createdAt"],
        "properties": {
          "id": { "type": "string", "format": "uuid" },
          "status": { "const": "submitted" },
          "createdAt": { "type": "string", "format": "date-time" }
        }
      },
      "DecisionInput": {
        "type": "object", "required": ["outcome", "reason"],
        "allOf": [{ "if": { "properties": { "outcome": { "const": "verified" } } }, "then": { "required": ["advice", "classification", "publicEvidenceIds"] } }],
        "properties": {
          "outcome": { "enum": ["verified", "rejected"] },
          "reason": { "type": "string", "minLength": 20, "maxLength": 1000 },
          "advice": { "type": "string", "minLength": 10, "maxLength": 500, "description": "Required when outcome is verified" },
          "classification": { "enum": ["credible_threat", "confirmed_incident"], "description": "Required when outcome is verified" },
          "publicEvidenceIds": { "type": "array", "minItems": 1, "maxItems": 10, "uniqueItems": true, "items": { "type": "string", "format": "uuid" }, "description": "Reviewer-approved evidence IDs to publish; required when verified" }
        }
      },
      "CorrectionInput": {
        "type": "object", "required": ["title", "advice", "reason"],
        "properties": {
          "title": { "type": "string", "minLength": 10, "maxLength": 160 },
          "advice": { "type": "string", "minLength": 10, "maxLength": 500 },
          "reason": { "type": "string", "minLength": 20, "maxLength": 1000 },
          "classification": { "enum": ["credible_threat", "confirmed_incident"] }
        }
      },
      "RetractionInput": {
        "type": "object", "required": ["reason"],
        "properties": { "reason": { "type": "string", "minLength": 20, "maxLength": 1000 } }
      },
      "OnchainFinding": {
        "type": "object", "required": ["evidenceId", "txHash", "state", "directTargetMatch"],
        "properties": {
          "evidenceId": { "type": "string", "format": "uuid" },
          "txHash": { "type": "string" },
          "state": { "enum": ["not_found", "pending", "mined"] },
          "directTargetMatch": { "type": ["boolean", "null"] },
          "txTo": { "type": ["string", "null"] },
          "blockNumber": { "type": "string" },
          "receiptStatus": { "enum": ["success", "failure", "unknown"] }
        }
      },
      "OnchainObservation": {
        "type": "object", "required": ["observedAt", "chainId", "findings"],
        "properties": {
          "observedAt": { "type": "string", "format": "date-time" },
          "chainId": { "type": "integer" },
          "findings": { "type": "array", "items": { "$ref": "#/components/schemas/OnchainFinding" } }
        }
      },
      "Report": {
        "allOf": [
          { "$ref": "#/components/schemas/ReportInput" },
          { "type": "object", "required": ["id", "status", "createdAt", "updatedAt", "history", "observations"],
            "properties": {
              "id": { "type": "string", "format": "uuid" },
              "status": { "enum": ["submitted", "in_review", "verified", "rejected", "retracted"] },
              "classification": { "type": ["string", "null"], "enum": ["informational", "under_investigation", "credible_threat", "confirmed_incident", null] },
              "evidence": { "type": "array", "items": { "$ref": "#/components/schemas/Evidence" } },
              "publicEvidenceIds": { "type": "array", "items": { "type": "string", "format": "uuid" } },
              "reviewerId": { "type": ["string", "null"] },
              "createdAt": { "type": "string", "format": "date-time" },
              "updatedAt": { "type": "string", "format": "date-time" },
              "observations": { "type": "array", "items": { "$ref": "#/components/schemas/OnchainObservation" } },
              "history": { "type": "array", "items": { "type": "object" } },
              "decision": { "type": ["object", "null"] },
              "alertVersions": { "type": "array", "items": { "type": "object" } },
              "retraction": { "type": ["object", "null"] }
            }
          }
        ]
      },
      "Alert": {
        "type": "object", "required": ["id", "status", "classification", "chainId", "contractAddress", "title", "advice", "disclaimer", "evidence", "publishedAt", "updatedAt", "version", "corrections", "onchainObservation"],
        "properties": {
          "id": { "type": "string", "format": "uuid" },
          "status": { "enum": ["verified", "retracted"] },
          "classification": { "enum": ["credible_threat", "confirmed_incident"] },
          "chainId": { "type": "integer" },
          "contractAddress": { "type": "string" },
          "title": { "type": "string" },
          "advice": { "type": "string" },
          "disclaimer": { "type": "string", "const": "Independent community project · Not affiliated with Monad Foundation · Not financial advice" },
          "evidence": { "type": "array", "items": { "$ref": "#/components/schemas/PublicEvidence" } },
          "onchainObservation": { "oneOf": [{ "$ref": "#/components/schemas/OnchainObservation" }, { "type": "null" }] },
          "publishedAt": { "type": "string", "format": "date-time" },
          "updatedAt": { "type": "string", "format": "date-time" },
          "version": { "type": "integer", "minimum": 1 },
          "corrections": { "type": "array", "items": { "type": "object" } },
          "retraction": { "type": "object" }
        }
      },
      "DashboardSummary": {
        "type": "object", "required": ["activeAlerts", "credibleThreats", "confirmedIncidents", "retractedAlerts", "lastUpdatedAt"],
        "properties": {
          "activeAlerts": { "type": "integer", "minimum": 0 },
          "credibleThreats": { "type": "integer", "minimum": 0 },
          "confirmedIncidents": { "type": "integer", "minimum": 0 },
          "retractedAlerts": { "type": "integer", "minimum": 0 },
          "lastUpdatedAt": { "type": ["string", "null"], "format": "date-time" }
        }
      },
      "WatchTargetInput": {
        "type": "object", "required": ["chainId", "address", "label"],
        "properties": {
          "chainId": { "type": "integer", "minimum": 1 },
          "address": { "type": "string", "pattern": "^0x[0-9a-fA-F]{40}$" },
          "label": { "type": "string", "minLength": 2, "maxLength": 120 }
        }
      },
      "WatchObservation": {
        "type": "object", "required": ["state", "observedAt", "chainId", "fromBlock", "toBlock", "latestBlock", "hasMore", "logCount", "duplicateCount", "samples"],
        "properties": {
          "state": { "enum": ["scanned", "up_to_date"] },
          "observedAt": { "type": "string", "format": "date-time" },
          "chainId": { "type": "integer" },
          "fromBlock": { "type": ["string", "null"], "description": "Null when no new blocks are available" },
          "toBlock": { "type": "string" },
          "latestBlock": { "type": "string" },
          "hasMore": { "type": "boolean" },
          "logCount": { "type": "integer", "minimum": 0 },
          "duplicateCount": { "type": "integer", "minimum": 0 },
          "samples": { "type": "array", "maxItems": 20, "items": {
            "type": "object", "required": ["txHash", "blockNumber", "blockHash", "logIndex", "topic0"],
            "properties": {
              "txHash": { "type": "string" },
              "blockNumber": { "type": "string" },
              "blockHash": { "type": "string" },
              "logIndex": { "type": "string" },
              "topic0": { "type": ["string", "null"] }
            }
          } }
        }
      },
      "WatchTarget": {
        "allOf": [
          { "$ref": "#/components/schemas/WatchTargetInput" },
          { "type": "object", "required": ["id", "active", "createdBy", "createdAt", "updatedAt", "observations"],
            "properties": {
              "id": { "type": "string", "format": "uuid" },
              "active": { "type": "boolean" },
              "createdBy": { "type": "string" },
              "createdAt": { "type": "string", "format": "date-time" },
              "updatedAt": { "type": "string", "format": "date-time" },
              "lastScannedBlock": { "type": ["string", "null"] },
              "observations": { "type": "array", "items": { "$ref": "#/components/schemas/WatchObservation" } },
              "archived": { "type": ["object", "null"] }
            }
          }
        ]
      },
      "NotificationEvent": {
        "type": "object", "required": ["id", "kind", "createdAt", "deliveryState", "alertId", "version", "status", "classification", "chainId", "contractAddress", "title", "advice", "disclaimer", "alertPath"],
        "properties": {
          "id": { "type": "string", "format": "uuid" },
          "kind": { "enum": ["published", "corrected", "retracted"] },
          "createdAt": { "type": "string", "format": "date-time" },
          "deliveryState": { "const": "draft" },
          "alertId": { "type": "string", "format": "uuid" },
          "version": { "type": "integer", "minimum": 1 },
          "status": { "enum": ["verified", "retracted"] },
          "classification": { "enum": ["credible_threat", "confirmed_incident"] },
          "chainId": { "type": "integer" },
          "contractAddress": { "type": "string" },
          "title": { "type": "string" },
          "advice": { "type": "string" },
          "disclaimer": { "type": "string", "const": "Independent community project · Not affiliated with Monad Foundation · Not financial advice" },
          "alertPath": { "type": "string" }
        }
      },
      "ContributorSummary": {
        "type": "object", "required": ["reporterId", "reportCount", "verifiedCount", "rejectedCount", "pendingCount", "lastReportedAt"],
        "properties": {
          "reporterId": { "type": "string" },
          "reportCount": { "type": "integer", "minimum": 0 },
          "verifiedCount": { "type": "integer", "minimum": 0 },
          "rejectedCount": { "type": "integer", "minimum": 0 },
          "pendingCount": { "type": "integer", "minimum": 0 },
          "lastReportedAt": { "type": ["string", "null"], "format": "date-time" }
        }
      }
    }
  }
}
